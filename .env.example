# Copy to .env and fill in. NEVER commit .env.
# Paper keys: https://app.alpaca.markets/paper/dashboard/overview -> API Keys -> Generate New Keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Leave true. Live trading comes much later, behind the risk manager.
ALPACA_PAPER=true
# Local dev database from docker-compose.yml (dev-only credentials).
DATABASE_URL=postgresql://arena:arena@localhost:5432/arena
